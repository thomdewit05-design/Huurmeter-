    "COROP-gebied": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "COROP region"
          }
        }
      }
    },
    "Categorie": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Category"
          }
        }
      }
    },
    "Categorieën uit Bijlage II bij het Besluit huurprijzen woonruimte. Twijfelt u, kies dan 'Weet ik niet'; de Huurcommissie beoordeelt het zelf.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Categories from Annex II of the Residential Rent Decree. If in doubt, choose 'Don't know'; the Rent Tribunal will assess it."
          }
        }
      }
    },
    "Conceptbrief aan de verhuurder": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Draft letter to the landlord"
          }
        }
      }
    },
    "Conceptbrief aan uw verhuurder": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Draft letter to your landlord"
          }
        }
      }
    },
    "Controleer de namen en functies. Een schuin dak of verlaagd plafond geeft u daarna per kamer aan.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Check the names and functions. You can then mark a sloping roof or lowered ceiling per room."
          }
        }
      }
    },
    "Controleer in Huurmeter of de verhoging binnen het maximum blijft en of het voorstel ten minste twee maanden vooraf kwam.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Check in Huurmeter whether the increase stays within the maximum and whether the proposal came at least two months in advance."
          }
        }
      }
    },
    "Controleer of dit klopt.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Check that this is correct."
          }
        }
      }
    },
    "Controleer of het voorstel binnen het maximum blijft. Bezwaar maakt u vóór de ingangsdatum.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Check whether the proposal stays within the maximum. Object before the start date."
          }
        }
      }
    },
    "Datum": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Date"
          }
        }
      }
    },
    "Datum waarop u het gebrek aan de verhuurder meldde": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Date on which you reported the defect to the landlord"
          }
        }
      }
    },
    "De app leest de kale huur en de ingangsdatum uit uw contract. Dat gebeurt op uw telefoon; de foto's worden niet bewaard.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The app reads the basic rent and start date from your contract. This happens on your phone; the photos are not stored."
          }
        }
      }
    },
    "De camera heeft ook voorzieningen herkend. Controleer ze; ze worden ingevuld bij Voorzieningen.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The camera also recognised facilities. Check them; they will be filled in under Facilities."
          }
        }
      }
    },
    "De gemeente heeft de verhuurder verplicht voorzieningen te treffen en dat is nog niet gebeurd": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The municipality has ordered the landlord to make provisions and this has not yet happened"
          }
        }
      }
    },
    "De hele onbebouwde oppervlakte. Bij een balkon meet u vanaf de binnenkant van het hek.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The entire unbuilt area. For a balcony, measure from the inside of the railing."
          }
        }
      }
    },
    "De huur zonder servicekosten, gas, water en licht. Staat in uw huurcontract of op de jaarlijkse huurverhogingsbrief.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The rent without service charges, gas, water and electricity. It is in your rental contract or in the yearly rent increase letter."
          }
        }
      }
    },
    "De kale huur en de ingangsdatum zijn niet gevonden. Scan de pagina met de huurprijs, of vul ze zelf in.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The basic rent and start date were not found. Scan the page with the rent, or enter them yourself."
          }
        }
      }
    },
    "De maximale kale huur en hoeveel u per maand en per jaar te veel betaalt": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The maximum basic rent and how much you overpay per month and per year"
          }
        }
      }
    },
    "De opnamedatum is niet gevonden; vul die zelf in.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The assessment date was not found; please enter it yourself."
          }
        }
      }
    },
    "De regels voor kamers konden niet worden geladen.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The rules for rooms could not be loaded."
          }
        }
      }
    },
    "De scan is niet gelukt. Probeer het opnieuw of vul de vragen zelf in.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The scan did not work. Try again or answer the questions yourself."
          }
        }
      }
    },
    "De scan meet de vloer van muur tot muur. Controleer de uitkomst en pas hem zo nodig aan.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The scan measures the floor from wall to wall. Check the result and adjust it if needed."
          }
        }
      }
    },
    "De stappenplannen konden niet worden geladen.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The step-by-step plans could not be loaded."
          }
        }
      }
    },
    "De termijn voor de Huurcommissie over %@ is verstreken (%@).": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The deadline for the Rent Tribunal for %@ has passed (%@)."
          }
        }
      }
    },
    "De verhuurder is aan zet": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It is up to the landlord"
          }
        }
      }
    },
    "De verhuurder kan tot zes weken na de ingangsdatum de Huurcommissie vragen uitspraak te doen. Doet hij dat niet, dan gaat de verhoging niet door.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The landlord can ask the Rent Tribunal for a ruling up to six weeks after the start date. If they do not, the increase does not go ahead."
          }
        }
      }
    },
    "De verhuurder moet het overzicht per kostensoort uiterlijk %@ geven (BW 7:259 lid 2).": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The landlord must provide the statement per cost type by %@ (Civil Code 7:259(2))."
          }
        }
      }
    },
    "De verhuurder moet u elk jaar, uiterlijk zes maanden na afloop van het kalenderjaar, een overzicht per kostensoort geven. U mag de onderliggende bonnen inzien.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Every year, no later than six months after the end of the calendar year, the landlord must give you a statement per cost type. You may inspect the underlying receipts."
          }
        }
      }
    },
    "De verwarming geeft te weinig warmte": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The heating gives too little heat"
          }
        }
      }
    },
    "De voordeur (of de deur van uw kamer) kan niet op slot": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The front door (or the door of your room) cannot be locked"
          }
        }
      }
    },
    "De waardepeildatum staat op de WOZ-beschikking van de gemeente, bijvoorbeeld 01-01-2025.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The valuation reference date is on the municipality's WOZ assessment, for example 01-01-2025."
          }
        }
      }
    },
    "Delen": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Share"
          }
        }
      }
    },
    "Deze termijn is verstreken.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This deadline has passed."
          }
        }
      }
    },
    "Deze verhoging mag": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This increase is allowed"
          }
        }
      }
    },
    "Dien het verzoek in binnen zes maanden na uw melding. Daarna kunt u over het verleden niet meer dan zes maanden huurverlaging krijgen.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Submit the request within six months of your report. After that you cannot get more than six months of rent reduction for the past."
          }
        }
      }
    },
    "Dien het verzoek schriftelijk in, uiterlijk op de datum hieronder. Dat kan met het formulier op huurcommissie.nl. Een voorstel aan de verhuurder is hiervoor niet nodig.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Submit the request in writing, no later than the date below. You can use the form on huurcommissie.nl. A proposal to the landlord is not needed for this."
          }
        }
      }
    },
    "Dit deel: %@ m": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This section: %@ m"
          }
        }
      }
    },
    "Dit heeft de camera gezien. Controleer elk punt en zet uit wat niet klopt.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This is what the camera saw. Check each item and turn off what is not right."
          }
        }
      }
    },
    "Dit is de ondergrens: de Huurcommissie kan de huur bij deze gebreken verlagen tot %1$@%% van uw huur. Hoeveel het precies wordt, bepaalt zij met haar gebrekenboek. %2$@ Bron: %3$@; %4$@.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This is the lower limit: for these defects the Rent Tribunal can reduce the rent to %1$@%% of your rent. The exact amount is set using its defects handbook. %2$@ Source: %3$@; %4$@."
          }
        }
      }
    },
    "Dit is de ondergrens: de Huurcommissie kan de huur bij deze gebreken verlagen tot %@%% van uw huur. Hoeveel het precies wordt, bepaalt zij met haar gebrekenboek. %@ Bron: %@; %@.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This is the lower limit: for these defects the Rent Tribunal can reduce the rent to %1$@%% of your rent. The exact amount is set using its defects handbook. %2$@ Source: %3$@; %4$@."
          }
        }
      }
    },
    "Dit is de ondergrens: de Huurcommissie kan de huur bij deze gebreken verlagen tot %lld%% van uw huur. Hoeveel het precies wordt, bepaalt zij met haar gebrekenboek. %@ Bron: %@; %@.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This is the lower limit: for these defects the Rent Tribunal can reduce the rent to %lld%% of your rent. The exact amount is set using its defects handbook. %@ Source: %@; %@."
          }
        }
      }
    },
    "Dit is een concept. Vul de gegevens tussen [haken] in en lees de brief goed na voordat u hem verstuurt. %@": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This is a draft in Dutch. Fill in the details between [brackets] and read the letter carefully before you send it. %@"
          }
        }
      }
    },
    "Dossier": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "File"
          }
        }
      }
    },
    "Dossier en brief": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "File and letter"
          }
        }
      }
    },
    "Dossier maken (PDF)": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Create file (PDF)"
          }
        }
      }
    },
    "Douches": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Showers"
          }
        }
      }
    },
    "Douches: %lld": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Showers: %lld"
          }
        }
      }
    },
    "Dubbele wastafel": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Double washbasin"
          }
        }
      }
    },
    "Een PDF-dossier om mee te nemen naar uw verhuurder of de Huurcommissie, en een conceptbrief.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A PDF file to take to your landlord or the Rent Tribunal, and a draft letter."
          }
        }
      }
    },
    "Een douche herkent de camera niet. Vul die zelf in.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The camera does not recognise a shower. Enter it yourself."
          }
        }
      }
    },
    "Een drempelloze woning in een complex met alarmering naar een meldkamer en gezamenlijke ruimtes voor maaltijden of recreatie.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A step-free home in a complex with an alarm connected to a control room and shared spaces for meals or recreation."
          }
        }
      }
    },
    "Een dubbele wastafel is minstens 70 cm breed en heeft twee kranen.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A double washbasin is at least 70 cm wide and has two taps."
          }
        }
      }
    },
    "Een eengezinswoning heeft geen andere woningen boven of onder zich, zoals een rijtjeshuis of vrijstaand huis. Al het andere (flat, boven- of benedenwoning) is een appartement.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A single-family home has no other homes above or below it, such as a terraced or detached house. Everything else (flat, upper or lower floor home) is an apartment."
          }
        }
      }
    },
    "Een energieprestatievergoeding is een aparte vergoeding voor bijvoorbeeld zonnepanelen bij een zeer zuinige woning. Staat dat niet in uw contract, laat dit dan uit.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "An energy performance fee is a separate fee, for example for solar panels in a very energy-efficient home. If it is not in your contract, leave this off."
          }
        }
      }
    },
    "Een hangend toilet hangt aan de muur, zonder voet.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A wall-hung toilet hangs on the wall, without a base."
          }
        }
      }
    },
    "Een kamer om in te verblijven, met een raam, minstens 4 m² en grotendeels 2,10 m hoog. Keuken en badkamer tellen altijd als kamer.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A room to stay in, with a window, at least 4 m² and mostly 2.10 m high. Kitchen and bathroom always count as a room."
          }
        }
      }
    },
    "Een melding twee weken en drie dagen voor het einde van de termijn voor de aanvangshuur, en elk jaar op 1 mei als de huurverhoging eraan komt.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A notification two weeks and three days before the deadline for the starting rent ends, and every year on 1 May when the rent increase is coming."
          }
        }
      }
    },
    "Een open keuken telt voor verwarming als apart vertrek. Verwarming per kamer vult u in bij Ruimtes.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "An open kitchen counts as a separate room for heating. Enter heating per room under Rooms."
          }
        }
      }
    },
    "Een ruimte van minstens 2 m² die geen kamer is, zoals een berging, zolder, bijkeuken of eigen garage.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A space of at least 2 m² that is not a room, such as a storage room, attic, utility room or own garage."
          }
        }
      }
    },
    "Een verzoek bij de Huurcommissie kost u %@. Krijgt u gelijk, dan krijgt u dit terug.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A request to the Rent Tribunal costs you %@. If you win, you get it back."
          }
        }
      }
    },
    "Eengezinswoning": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Single-family home"
          }
        }
      }
    },
    "Eenhendelmengkraan": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Single-lever mixer tap"
          }
        }
      }
    },
    "Eenhendelmengkranen": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Single-lever mixer taps"
          }
        }
      }
    },
    "Eenmalige aankoop. Geen abonnement en geen advertenties. Uw gegevens blijven op uw telefoon.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "One-time purchase. No subscription and no ads. Your data stays on your phone."
          }
        }
      }
    },
    "Eerdere aankoop herstellen": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Restore previous purchase"
          }
        }
      }
    },
    "Eigen balkon of tuin": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Own balcony or garden"
          }
        }
      }
    },
    "Eigen berging, zolder e.d.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Own storage, attic etc."
          }
        }
      }
    },
    "Eigen buitenruimte": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Private outdoor space"
          }
        }
      }
    },
    "Eigen kamers met koeling": {
      "localizations": {
