            "value": "Energy performance fee agreed"
          }
        }
      }
    },
    "Er is niets gevonden om over te nemen. Scan de pagina waar het op staat, of vul het zelf in.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Nothing was found to take over. Scan the page it is on, or enter it yourself."
          }
        }
      }
    },
    "Er is niets herkend dat punten oplevert. Vul de vragen zelf in.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
