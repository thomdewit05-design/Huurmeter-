      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A room without its own front door, kitchen or toilet has its own points system. Shared spaces count pro rata: their points are divided by the number of rooms allowed to use them."
          }
        }
      }
    },
