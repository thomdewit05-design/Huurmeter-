    "NSCameraUsageDescription": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Huurmeter uses the camera to measure your rooms. The images are not stored and do not leave your phone."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Huurmeter gebruikt de camera om uw kamers in te meten. De beelden worden niet bewaard en verlaten uw telefoon niet."
          }
        }
      }
    }
